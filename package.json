{
  "name": "glass-cockpit-web",
  "version": "0.1.0",
  "description": "A working glass cockpit for the browser: PFD and MFD with bezel, softkey menus, radios, transponder, timer, nearest airports and nav map. Ported from FlightGear's FG1000.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "main": "dist/glass-pfd.js",
  "types": "dist/glass-pfd.d.ts",
  "exports": {
    ".": "./dist/glass-pfd.js",
    "./radio": "./dist/radio.js",
    "./vue/*": "./vue/*"
  },
  "files": ["dist", "src", "vue", "LICENSE"],
  "scripts": {
    "test": "tsc && node --test test/",
    "build": "node scripts/build-svg.mjs && tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
